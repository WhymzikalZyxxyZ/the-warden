<Window
    x:Class="TheWarden.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TheWarden.Core.Scanning"
    xmlns:quarantine="using:TheWarden.Core.Quarantine"
    xmlns:reputation="using:TheWarden.Core.Reputation"
    xmlns:vm="using:TheWarden.App.ViewModels">

    <Grid Padding="24" ColumnSpacing="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="The Warden" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.8" VerticalAlignment="Center"/>
            <Button Content="Relaunch as Administrator"
                    Click="RelaunchElevatedButton_Click"
                    Visibility="{x:Bind ViewModel.LastOperationNeedsElevation, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="VirusTotal API key:" VerticalAlignment="Center" Opacity="0.8"/>
            <PasswordBox Password="{x:Bind ViewModel.ApiKeyInput, Mode=TwoWay}"
                         Width="260"
                         PlaceholderText="Paste your API key to enable reputation checks + malware scan"
                         Visibility="{x:Bind ViewModel.NeedsApiKey, Mode=OneWay}"/>
            <Button Content="Save"
                    Click="SaveApiKeyButton_Click"
                    Visibility="{x:Bind ViewModel.NeedsApiKey, Mode=OneWay}"/>
            <TextBlock Text="API key saved — reputation checks and malware scan enabled."
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Visibility="{x:Bind ViewModel.HasApiKey, Mode=OneWay}"/>
            <Button Content="Remove key"
                    Click="ClearApiKeyButton_Click"
                    Visibility="{x:Bind ViewModel.HasApiKey, Mode=OneWay}"/>
        </StackPanel>

        <Pivot Grid.Row="3">

            <!-- ══════════════════════════ Junk Cleanup ══════════════════════════ -->
            <PivotItem Header="Junk Cleanup">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Scan for junk"
                            Click="ScanButton_Click"
                            IsEnabled="{x:Bind Not(ViewModel.IsBusy), Mode=OneWay}"/>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="24">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Findings" FontWeight="SemiBold"/>
                            <ListView ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:FileFinding">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="4">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind RuleDescription}" FontSize="11" Opacity="0.6"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Check Reputation" Click="CheckReputationButton_Click" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="Quarantine" Click="QuarantineButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Quarantine (restorable)" FontWeight="SemiBold"/>
                            <ListView ItemsSource="{x:Bind ViewModel.QuarantinedItems, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="quarantine:QuarantineRecord">
                                        <Grid ColumnDefinitions="*,Auto" Padding="4">
                                            <TextBlock Grid.Column="0" Text="{x:Bind OriginalPath}" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Restore" Click="RestoreButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- ══════════════════════════ Malware Scan ══════════════════════════ -->
            <PivotItem Header="Malware Scan">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Checks Downloads, Desktop, AppData, and Startup folders by default. Only each file's hash is sent to VirusTotal — never file contents. Nothing found is ever quarantined automatically; every action here needs your say-so."
                               TextWrapping="Wrap" Opacity="0.65" FontSize="12" MaxWidth="700"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Quick Scan"
                                Click="QuickMalwareScanButton_Click"
                                IsEnabled="{x:Bind Not(ViewModel.IsScanningForMalware), Mode=OneWay}"/>
                        <Button Content="Full Drive Scan…"
                                Click="FullDriveMalwareScanButton_Click"
                                IsEnabled="{x:Bind Not(ViewModel.IsScanningForMalware), Mode=OneWay}"/>
                        <Button Content="Cancel Scan"
                                Click="CancelMalwareScanButton_Click"
                                Visibility="{x:Bind ViewModel.IsScanningForMalware, Mode=OneWay}"/>
                        <Button Content="Quarantine All Flagged"
                                Click="QuarantineAllFlaggedButton_Click"
                                Visibility="{x:Bind ViewModel.HasFlaggedMalware, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.MalwareScanStatusText, Mode=OneWay}" FontSize="13"/>
                        <ProgressBar Value="{x:Bind ViewModel.MalwareScanProgress, Mode=OneWay}"
                                     Minimum="0" Maximum="1"
                                     Visibility="{x:Bind ViewModel.IsScanningForMalware, Mode=OneWay}"/>
                    </StackPanel>

                    <!-- File-type breakdown: a small dependency-free bar chart — each row's
                         Border width is a precomputed pixel value (see FileTypeCount),
                         not something computed here in XAML. -->
                    <StackPanel Grid.Row="3" Spacing="4"
                                Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay}">
                        <TextBlock Text="Files found, by type" FontWeight="SemiBold" FontSize="13"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FileTypeBreakdown, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileTypeCount">
                                    <Grid ColumnDefinitions="70,Auto,*" Padding="0,2">
                                        <TextBlock Grid.Column="0" Text="{x:Bind Extension}" FontFamily="Consolas" FontSize="12"/>
                                        <Border Grid.Column="1" Width="{x:Bind BarWidthPixels}" Height="12"
                                                Background="#5B8FD9" CornerRadius="2" Margin="6,0"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontSize="12" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Spacing="8">
                        <TextBlock Text="Flagged for review" FontWeight="SemiBold"/>
                        <ListView ItemsSource="{x:Bind ViewModel.MalwareFindings, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="reputation:MalwareFinding">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="4" ColumnSpacing="8">
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Background="#C0392B" Visibility="{x:Bind IsMalicious, Mode=OneWay}">
                                            <TextBlock Text="Malicious" FontSize="11" Foreground="White"/>
                                        </Border>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Background="#D68910" Visibility="{x:Bind IsSuspiciousOnly, Mode=OneWay}">
                                            <TextBlock Text="Suspicious" FontSize="11" Foreground="White"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Opacity="0.6">
                                                <Run Text="{x:Bind Verdict.MaliciousEngineCount}"/>
                                                <Run Text="/"/>
                                                <Run Text="{x:Bind Verdict.TotalEngineCount}"/>
                                                <Run Text="engines"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="Quarantine" Click="QuarantineMalwareButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <!-- ══════════════════════════ Scan History ══════════════════════════ -->
            <PivotItem Header="Scan History">
                <ListView ItemsSource="{x:Bind ViewModel.ScanHistory, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:ScanHistoryEntry">
                            <Grid ColumnDefinitions="160,110,Auto,Auto,Auto" Padding="4" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" Text="{x:Bind TimestampUtc}" FontSize="12" Opacity="0.8"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Scope}" FontSize="12"/>
                                <TextBlock Grid.Column="2" FontSize="12">
                                    <Run Text="{x:Bind FilesChecked}"/>
                                    <Run Text="checked"/>
                                </TextBlock>
                                <TextBlock Grid.Column="3" FontSize="12">
                                    <Run Text="{x:Bind FilesFlagged}"/>
                                    <Run Text="flagged"/>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{x:Bind Outcome}" FontSize="12" Opacity="0.7"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>

        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.HealthSummaryText, Mode=OneWay}" Opacity="0.6" FontSize="12"/>
    </Grid>
</Window>
